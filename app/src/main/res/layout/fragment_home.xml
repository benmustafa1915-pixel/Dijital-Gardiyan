<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DİJİTAL GARDİYAN"
        android:textColor="#FF5722"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/tvStrictStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Durum: Normal Mod"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etHomePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Yönetici Şifresi"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textSize="18sp"
        android:imeOptions="actionDone"
        android:singleLine="true"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnStartStrict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SIKI MODU AÇ (1 SAAT)"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

</LinearLayout>
