<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DİJİTAL GARDIYAN"
        android:textColor="#FF5722"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Yönetici Şifresi"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textSize="20sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnToggleStrict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sıkı Modu Aç (1 Saat)"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Erişilebilirlik İznini Ver"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnHideIcon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simgeyi Gizle (Gizli Mod)"
        android:backgroundTint="#9C27B0"
        android:textColor="#FFFFFF" />

</LinearLayout>
